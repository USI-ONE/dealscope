# ----------------------------------------------------------------------------
# DealScope environment template — copy to .env.local and fill in.
# ----------------------------------------------------------------------------

# --- Database (Neon) ---
# Pooled URL for the app (recommended at runtime).
DATABASE_URL=postgres://USER:PASSWORD@HOST.pooler.neon.tech/DBNAME?sslmode=require
# Unpooled URL for migrations (drizzle-kit + db:apply).
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# --- Auth.js (NextAuth v5) ---
# Generate with: `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET=

# Required only for production (set automatically on Vercel as VERCEL_URL)
AUTH_URL=http://localhost:3000

# --- Anthropic AI ---
ANTHROPIC_API_KEY=

# --- App config ---
# Comma-separated emails granted owner role on first sign-in (bootstrap).
DEALSCOPE_OWNER_EMAILS=
